+  background:var(--ca-bg); color:var(--ca-text); border-radius:18px; border:1px solid var(--ca-line);
+  box-shadow:0 20px 60px rgba(0,0,0,.3); display:flex; flex-direction:column; overflow:hidden; animation:caIn .25s ease; }
+.care-asst-panel[hidden]{ display:none; }
+.care-asst-head{ flex:none; display:flex; align-items:center; gap:10px; padding:12px 14px; color:#fff;
+  background:linear-gradient(135deg,var(--ca-head1),var(--ca-head2)); }
+.care-asst-head *{ color:#fff; }
+.ca-avatar{ flex:none; width:40px; height:40px; border-radius:50%; background:rgba(255,255,255,.22); display:flex; align-items:center; justify-content:center; font-size:21px; }
+.ca-who{ flex:1; min-width:0; } .ca-who b{ display:block; font-size:16px; line-height:1.25; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+.ca-who small{ display:flex; align-items:center; gap:5px; opacity:.95; font-size:12px; line-height:1.3; }
+.ca-online{ width:8px; height:8px; border-radius:50%; background:#4ade80; flex:none; }
+.care-asst-x, .ca-voice{ flex:none; background:rgba(255,255,255,.2); color:#fff; border:0; border-radius:50%; width:38px; height:38px; cursor:pointer; font-size:16px; padding:0; }
+.ca-voice.on{ background:rgba(255,255,255,.42); }
+.ca-voice[hidden], .ca-mic[hidden]{ display:none; }
+
+.care-asst-log{ flex:1; min-height:0; overflow-y:auto; -webkit-overflow-scrolling:touch; overscroll-behavior:contain; padding:12px; display:flex; flex-direction:column; gap:8px; background:var(--ca-log); }
+.ca-msg{ max-width:92%; padding:9px 12px; border-radius:14px; font-size:15px; line-height:1.55; overflow-wrap:anywhere; word-break:normal; animation:caIn .25s ease; color:var(--ca-text); }
+.ca-msg p{ margin:0 0 6px; } .ca-msg p:last-child{ margin:0; } .ca-msg ul{ margin:4px 0 6px; padding-inline-start:18px; } .ca-msg li{ margin:2px 0; }
+.ca-msg hr{ border:0; border-top:1px dashed var(--ca-line); margin:8px 0; }
+.ca-msg a{ color:var(--ca-link); font-weight:700; text-decoration:underline; text-underline-offset:2px; }
+.ca-msg small{ font-size:13px; color:var(--ca-muted); }
+.ca-bot{ align-self:flex-start; background:var(--ca-bot); border:1px solid var(--ca-line); border-end-start-radius:4px; }
+.ca-me{ align-self:flex-end; background:var(--ca-me); color:var(--ca-me-text); border-end-end-radius:4px; }
+.ca-me *{ color:var(--ca-me-text); }
+.ca-urgent-box{ border-color:#f19999; background:var(--ca-urgent-bg); } .ca-urgent{ color:var(--ca-urgent) !important; }
+.ca-msg .ca-btn, .ca-btn{ display:inline-block; margin-top:4px; padding:8px 13px; border-radius:12px; background:var(--ca-me); color:#fff !important; text-decoration:none; font-weight:700; }
+.ca-tag{ display:inline-block; font-size:11.5px; padding:1px 7px; border-radius:9px; background:var(--ca-tag); color:var(--ca-tag-text) !important; font-weight:700; }
+.ca-sum{ border-collapse:collapse; width:100%; font-size:14px; } .ca-sum td{ padding:4px; border-bottom:1px solid var(--ca-line); vertical-align:top; color:var(--ca-text); } .ca-sum td:first-child{ color:var(--ca-muted); width:38%; }
+.ca-date{ font:inherit; font-size:16px; padding:8px 10px; border:1px solid var(--ca-chip-line); border-radius:10px; background:var(--ca-input); color:var(--ca-text); }
+.ca-fb{ display:flex; gap:4px; margin-top:6px; } .ca-fb button{ border:1px solid var(--ca-line); background:var(--ca-input); color:var(--ca-text); border-radius:10px; padding:2px 8px; cursor:pointer; font-size:13px; }
+.ca-fb small{ color:var(--ca-muted); }
+.ca-typing{ padding:11px 14px; }
+.ca-dots{ display:inline-flex; gap:4px; } .ca-dots i{ width:7px; height:7px; border-radius:50%; background:var(--ca-muted); animation:caDot 1.2s infinite; }
+.ca-dots i:nth-child(2){ animation-delay:.2s; } .ca-dots i:nth-child(3){ animation-delay:.4s; }
+@keyframes caDot{ 0%,60%,100%{ transform:none; opacity:.5;} 30%{ transform:translateY(-4px); opacity:1;} }
+
+.care-asst-chips{ flex:none; display:flex; gap:6px; overflow-x:auto; padding:8px 10px 2px; scrollbar-width:none; -webkit-overflow-scrolling:touch; }
+.care-asst-chips::-webkit-scrollbar{ display:none; }
