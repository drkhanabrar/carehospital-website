+.care-asst-form .ca-mic{ background:var(--ca-soft); color:var(--ca-chip-text); padding:0 11px; font-size:17px; }
+.care-asst-form .ca-mic.on{ background:#fde2e2; animation:caPulse 1.2s infinite; }
+.care-asst[dir="rtl"] .ca-send{ transform:scaleX(-1); }
+.care-asst-foot{ flex:none; display:flex; flex-wrap:wrap; align-items:center; gap:8px; padding:0 10px 10px; }
+.care-asst-foot a{ font-size:13px; font-weight:700; text-decoration:none; color:var(--ca-chip-text); border:1px solid var(--ca-chip-line); border-radius:14px; padding:5px 10px; background:var(--ca-chip); }
+.care-asst-foot small{ flex-basis:100%; color:var(--ca-muted); font-size:11.5px; line-height:1.4; }
+.ca-langs{ display:flex; flex-wrap:wrap; gap:6px; margin-top:6px !important; }
+.ca-langs button{ border:1px solid var(--ca-chip-line); background:var(--ca-soft); color:var(--ca-chip-text); border-radius:14px; padding:7px 13px; font:inherit; font-size:15px; font-weight:700; cursor:pointer; }
+.ca-langs button:hover{ filter:brightness(.97); }
+
+/* 🌙 dark mode of the phone / computer */
+@media (prefers-color-scheme: dark){
+  .care-asst{
+    --ca-bg:#13232a; --ca-log:#0d1a1f; --ca-text:#eaf4f5; --ca-muted:#b4c8cc; --ca-line:#2c4249;
+    --ca-bot:#1a2e35; --ca-me:#0e7c8f; --ca-link:#7fe3ec; --ca-chip:#1a2e35; --ca-chip-text:#9fe8ee; --ca-chip-line:#36545b;
+    --ca-soft:#203a41; --ca-input:#1a2e35; --ca-urgent-bg:#3a1515; --ca-urgent:#ffb4b4; --ca-tag:#1f4a4c; --ca-tag-text:#c9f4f2;
+    color-scheme:dark;
+  }
+  .care-asst-form .ca-mic.on{ background:#5b1d1d; }
+}
+
+/* 📱 phones and small tablets: a full-screen chat that follows the visible screen */
+@media (max-width:600px){
+  .care-asst{ left:calc(10px + env(safe-area-inset-left, 0px)); bottom:calc(14px + env(safe-area-inset-bottom, 0px)); }
+  .care-asst-fab{ width:56px; height:56px; font-size:25px; }
+  .care-asst.open{ left:0; right:0; top:0; bottom:0; }
+  .care-asst.open .care-asst-panel{ width:100%; height:100%; max-height:none; border-radius:0; border:0;
+    padding-bottom:env(safe-area-inset-bottom, 0px); }
+  .care-asst.open .care-asst-head{ padding-top:calc(12px + env(safe-area-inset-top, 0px)); }
+}
+/* short screens (phones turned sideways, small laptops) */
+@media (max-height:520px) and (min-width:601px){
+  .care-asst.open{ bottom:8px; }
+  .care-asst-panel{ height:calc(100vh - 16px); height:calc(100dvh - 16px); }
+  .care-asst-foot small{ display:none; }
+}
+html.care-asst-lock, html.care-asst-lock body{ overflow:hidden !important; }
+@media (prefers-reduced-motion: reduce){ .care-asst *{ animation:none !important; transition:none !important; } }
+@media print{ .care-asst{ display:none !important; } }
