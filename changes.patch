@@ -0,0 +1,125 @@
+/* ==========================================================
+   💬 CARE website assistant "Care Saathi" (js/care-assistant.js) — v2
+   Bottom-LEFT, so it never covers the Book / Call / WhatsApp
+   buttons on the right.
+   • Open: above the site header (header z-index 9999), so the
+     phone's top bar / site menu never covers it.
+   • Phones: full-screen sheet that follows the visible screen
+     (dvh + safe areas, keyboard-friendly).
+   • Light and dark: every colour is set here (site styles and
+     the phone's "dark mode for websites" cannot turn the text
+     grey or unreadable).
+========================================================== */
+.care-asst{
+  --ca-bg:#ffffff; --ca-log:#f4f8f8; --ca-text:#132a30; --ca-muted:#4b6268; --ca-line:#d5e3e6;
+  --ca-bot:#ffffff; --ca-me:#0B7285; --ca-me-text:#ffffff; --ca-link:#0a6577; --ca-chip:#ffffff; --ca-chip-text:#0a6577; --ca-chip-line:#bcd9dc;
+  --ca-soft:#e8f5f5; --ca-input:#ffffff; --ca-urgent-bg:#fff1f1; --ca-urgent:#a61b1b; --ca-tag:#dff2f1; --ca-tag-text:#0b5258;
+  --ca-head1:var(--primary,#0B7285); --ca-head2:var(--accent,#15A3A5);
+  color-scheme:light;
+  position:fixed; left:15px; bottom:20px; z-index:1150;
+  font-family:inherit; color:var(--ca-text); line-height:1.5; text-align:start;
+  -webkit-text-size-adjust:100%; text-size-adjust:100%;
+}
+.care-asst.open{ z-index:10040; }   /* above the header (9999) and the mobile menu; below search / video pop-ups */
+.care-asst *, .care-asst *::before, .care-asst *::after{ box-sizing:border-box; }
+/* site-wide styles (p, li, small, a …) must not change the chat's colours */
+.care-asst p, .care-asst li, .care-asst span, .care-asst b, .care-asst strong, .care-asst small, .care-asst td, .care-asst i, .care-asst h3, .care-asst h4{ color:inherit; font-family:inherit; letter-spacing:normal; text-transform:none; }
+.care-asst p{ font-size:inherit; line-height:inherit; }
+
+.care-asst-fab{ position:relative; width:62px; height:62px; border-radius:50%; border:0; cursor:pointer; font-size:28px; color:#fff; padding:0;
+  background:linear-gradient(135deg,var(--ca-head1),var(--ca-head2)); box-shadow:0 10px 30px rgba(0,0,0,.25); transition:transform .25s ease; }
+.care-asst-fab:hover{ transform:scale(1.06); }
+.ca-fab-dot{ position:absolute; top:6px; right:6px; width:12px; height:12px; border-radius:50%; background:#22c55e; border:2px solid #fff; animation:caPulse 2s infinite; }
+@keyframes caPulse{ 0%{ box-shadow:0 0 0 0 rgba(34,197,94,.6);} 70%{ box-shadow:0 0 0 9px rgba(34,197,94,0);} 100%{ box-shadow:0 0 0 0 rgba(34,197,94,0);} }
