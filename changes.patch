+.care-asst-chips button:hover{ background:var(--ca-soft); }
+.care-asst-form{ flex:none; display:flex; gap:6px; padding:8px 10px; }
+/* 16px stops iPhones zooming the page when typing */
+.care-asst-form input{ flex:1; min-width:0; border:1px solid var(--ca-chip-line); border-radius:12px; padding:10px 12px; font:inherit; font-size:16px; background:var(--ca-input); color:var(--ca-text); }
+.care-asst-form input::placeholder{ color:var(--ca-muted); opacity:1; }
