+  .pa-wrap{ grid-template-columns:minmax(0,1fr); }
+  .pa-phone{ width:min(70%,230px); order:-1; }
+}
+@media (max-width:480px){
+  .pa-actions{ flex-direction:column; align-items:stretch; }
+  .pa-btn{ width:100%; }
+  .pa-card{ padding:18px; }
+}
