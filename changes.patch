+.pa-steps{ display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr)); gap:18px; margin-top:24px; }
+.pa-card{ background:#fff; border:1px solid #dbe9eb; border-radius:18px; padding:22px; min-width:0; box-shadow:0 8px 24px rgba(15,47,53,.06); }
